# Copy to .env and fill in real values. Never commit .env.

# LLM provider
LLM_API_KEY=changeme
LLM_MODEL=changeme

# SEC EDGAR requires a descriptive User-Agent: "Name email@example.com"
SEC_USER_AGENT=changeme

# Vector store connection string
VECTOR_STORE_URL=changeme

# Local data directory for raw and processed artifacts
DATA_DIR=./data

LOG_LEVEL=INFO
